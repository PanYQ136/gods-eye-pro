node_modules
dist
# Credential files. `.env` alone is not enough: Vite's loadEnv (see
# server/standalone/vite.config.js) and scripts/setup-doctor.mjs both read the
# full dotenv ladder — .env, .env.local, .env.<mode> and .env.<mode>.local —
# so a key placed in any of them is live for the app. Only .env was ignored,
# leaving the other three committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
.DS_Store
.gstack/
3d-models/
# Runtime scratch dirs and generated model caches (derived from public/models/*.glb
# by the local bake/normalize experiments; not referenced by any source file).
cache/
public/models/_baked/
public/models/_norm/
public/models/_skb/
pinokio/ENVIRONMENT
pinokio/.installed

.vercel
.env*
